# Use live backend gateway mode in production integration.
VITE_API_MODE=live
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=10000
VITE_SESSION_TIMEOUT_MS=1800000

# Uptime Kuma
VITE_UPTIME_KUMA_ENABLED=false
# Frontend direct provider access is disabled by architecture policy.
VITE_UPTIME_KUMA_DIRECT=false
VITE_UPTIME_KUMA_URL=
VITE_UPTIME_KUMA_MONITORS_PATH=/api/monitors
VITE_UPTIME_KUMA_INCIDENTS_PATH=/api/incidents

# Portainer
VITE_PORTAINER_ENABLED=false
# Frontend direct provider access is disabled by architecture policy.
VITE_PORTAINER_DIRECT=false
VITE_PORTAINER_URL=
VITE_PORTAINER_CONTAINERS_PATH=/api/endpoints/1/docker/containers/json?all=true

# Docker Host (backend gateway integration settings)
VITE_DOCKER_ENABLED=false
VITE_DOCKER_HOST=

# Proxmox
VITE_PROXMOX_ENABLED=false
# Frontend direct provider access is disabled by architecture policy.
VITE_PROXMOX_DIRECT=false
VITE_PROXMOX_URL=
VITE_PROXMOX_VMS_PATH=/api2/json/cluster/resources?type=vm

# Nginx Proxy Manager
VITE_NPM_ENABLED=false
# Frontend direct provider access is disabled by architecture policy.
VITE_NPM_DIRECT=false
VITE_NPM_URL=
VITE_NPM_HOSTS_PATH=/api/nginx/proxy-hosts
VITE_NPM_CERTIFICATES_PATH=/api/nginx/certificates

# Ubuntu Servers (backend gateway integration settings)
VITE_UBUNTU_ENABLED=false
VITE_UBUNTU_HOSTS=

# Storage Servers (backend gateway integration settings)
VITE_STORAGE_ENABLED=false
VITE_STORAGE_ENDPOINTS=

# Network Devices (backend gateway integration settings)
VITE_NETWORK_ENABLED=false
VITE_NETWORK_ENDPOINTS=
