{
  "name": "telemab-broadcast-platform",
  "version": "2.0.0",
  "description": "Enterprise broadcast platform - Service-oriented architecture",
  "private": true,
  "workspaces": [
    "services/platform-core/libs/*",
    "services/auth-service",
    "services/reporter-service",
    "services/media-service",
    "services/producer-control-service",
    "services/streaming-service",
    "services/recording-service",
    "services/asset-service",
    "services/ai-service",
    "services/notification-service",
    "services/analytics-service",
    "services/monitoring-service",
    "services/admin-service"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "build:all": "npm run build --workspaces",
    "test:all": "npm test --workspaces",
    "clean:all": "npm run clean --workspaces && find . -name dist -type d -exec rm -rf {} + 2>/dev/null; exit 0",
    "lint:all": "eslint services --ext .ts,.tsx --no-error-on-unmatched-pattern || true",
    "format:all": "prettier --write 'services/**/*.{ts,tsx,json,md}'",
    "dev:tmos": "bash ./ops/dev-up.sh",
    "dev:tmos:down": "bash ./ops/dev-down.sh",
    "dev:tmos:status": "bash ./ops/dev-status.sh",
    "dev:tmos:api-smoke": "bash ./ops/api-smoke.sh",
    "start:dev": "docker-compose -f docker-compose.dev.yml up",
    "start:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "start:dev:clean": "docker-compose -f docker-compose.dev.yml down -v"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
