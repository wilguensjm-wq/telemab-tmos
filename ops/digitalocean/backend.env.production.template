NODE_ENV=production
PORT=8081

TMOS_DATABASE_URL=postgres://TMOS_DB_USER:TMOS_DB_PASSWORD@127.0.0.1:5432/tmos
TMOS_DATABASE_SSL=false
TMOS_DATABASE_REQUIRED=true

TMOS_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
TMOS_ADMIN_USER=admin_prod
TMOS_ADMIN_PASS=REPLACE_WITH_STRONG_PASSWORD
TMOS_ACCESS_TOKEN_TTL=15m
TMOS_REFRESH_TOKEN_TTL=7d

TMOS_MEDIA_LIVEKIT_ENABLED=true
TMOS_MEDIA_LIVEKIT_WS_URL=wss://reporter.REPLACE_DOMAIN/ws
TMOS_MEDIA_LIVEKIT_API_KEY=REPLACE_LIVEKIT_API_KEY
TMOS_MEDIA_LIVEKIT_API_SECRET=REPLACE_LIVEKIT_API_SECRET
TMOS_MEDIA_LIVEKIT_TOKEN_TTL_SECONDS=3600

TMOS_ENFORCE_VPN_POLICY_ON_STARTUP=true
TMOS_VPN_POLICY_EMERGENCY_OVERRIDE=false

# Keep disabled unless explicitly needed.
PROXMOX_ENABLED=false
DOCKER_ENABLED=false
UPTIME_KUMA_ENABLED=false
NPM_ENABLED=false
