[Unit]
Description=TMOS Backend API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=tmos
Group=tmos
WorkingDirectory=/opt/tmos/backend
EnvironmentFile=/etc/tmos/backend.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
