PORT=8080
NODE_ENV=development
TMOS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tmos
TMOS_DATABASE_SSL=false
TMOS_DATABASE_MAX_POOL=10
TMOS_DATABASE_IDLE_TIMEOUT_MS=30000
TMOS_DATABASE_REQUIRED=true
TMOS_JWT_SECRET=replace-me
TMOS_ADMIN_USER=operator
TMOS_ADMIN_PASS=operator
TMOS_ACCESS_TOKEN_TTL=15m
TMOS_REFRESH_TOKEN_TTL=7d
TMOS_PROVIDER_TIMEOUT_MS=10000
TMOS_ENFORCE_VPN_POLICY_ON_STARTUP=true
TMOS_VPN_POLICY_EMERGENCY_OVERRIDE=false

PROXMOX_ENABLED=false
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_TLS_STRICT=true
PROXMOX_NODES_PATH=/api2/json/nodes
PROXMOX_VMS_PATH=/api2/json/cluster/resources?type=vm
PROXMOX_STORAGE_PATH=/api2/json/cluster/resources?type=storage
PROXMOX_TASKS_PATH=/api2/json/cluster/tasks
PROXMOX_ALERTS_PATH=/api2/json/cluster/tasks
PROXMOX_LOGS_PATH=/api2/json/nodes/log
PROXMOX_START_PATH=/api2/json/nodes/{node}/qemu/{vmid}/status/start
PROXMOX_STOP_PATH=/api2/json/nodes/{node}/qemu/{vmid}/status/stop
PROXMOX_RESTART_PATH=/api2/json/nodes/{node}/qemu/{vmid}/status/reboot

# Ubuntu Servers (planned backend integration)
UBUNTU_ENABLED=false
UBUNTU_HOSTS=
UBUNTU_SSH_USERNAME=
UBUNTU_SSH_KEY_PATH=

# Docker Host (planned backend integration)
DOCKER_ENABLED=true
DOCKER_HOST=
DOCKER_API_VERSION=

# Portainer (planned backend integration)
PORTAINER_ENABLED=false
PORTAINER_URL=
PORTAINER_API_KEY=

# Nginx Proxy Manager (planned backend integration)
NPM_ENABLED=true
NPM_URL=
NPM_ACCESS_TOKEN=
NPM_CONTAINER=nginx-proxy-manager
NPM_DATABASE_PATH=/data/database.sqlite

# Uptime Kuma (local live integration)
UPTIME_KUMA_ENABLED=true
UPTIME_KUMA_CONTAINER=uptime-kuma
UPTIME_KUMA_DATABASE_PATH=/app/data/kuma.db

# Storage (planned backend integration)
STORAGE_ENABLED=false
STORAGE_ENDPOINTS=
STORAGE_USERNAME=

# Network Devices (planned backend integration)
NETWORK_ENABLED=false
NETWORK_ENDPOINTS=
NETWORK_USERNAME=
